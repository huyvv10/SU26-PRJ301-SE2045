<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <servlet>
        <servlet-name>CalculateServlet</servlet-name>
        <servlet-class>controlers.CalculateServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TinhToanServlet</servlet-name>
        <servlet-class>controlers.TinhToanServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ElectricityCostServlet</servlet-name>
        <servlet-class>controlers.ElectricityCostServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ExchangeCurrencyServlet</servlet-name>
        <servlet-class>controlers.ExchangeCurrencyServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CalculateServlet</servlet-name>
        <url-pattern>/calculate</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TinhToanServlet</servlet-name>
        <url-pattern>/tinhtoan</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ElectricityCostServlet</servlet-name>
        <url-pattern>/electcost</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ExchangeCurrencyServlet</servlet-name>
        <url-pattern>/exchangecurrency</url-pattern>
    </servlet-mapping>
</web-app>
